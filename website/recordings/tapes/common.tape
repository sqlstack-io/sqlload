Set Shell bash
Set FontFamily "DejaVu Sans Mono"
Set FontSize 18
Set LineHeight 1.0
Set Width 1200
Set Height 520
Set Padding 28
Set Margin 24
Set MarginFill "#0d0f12"
Set BorderRadius 10
Set WindowBar Colorful
Set TypingSpeed 40ms
Set Theme { "name": "SQLLoad", "black": "#5c606b", "red": "#ff5760", "green": "#79c98a", "yellow": "#e3b341", "blue": "#5aa9e6", "magenta": "#c79bf0", "cyan": "#4dd6c4", "white": "#c9cdd4", "brightBlack": "#8a909c", "brightRed": "#ff5760", "brightGreen": "#79c98a", "brightYellow": "#e3b341", "brightBlue": "#5aa9e6", "brightMagenta": "#c79bf0", "brightCyan": "#4dd6c4", "brightWhite": "#e9ebef", "background": "#111418", "foreground": "#c9cdd4", "selection": "#2a2f37", "cursor": "#e9ebef" }
